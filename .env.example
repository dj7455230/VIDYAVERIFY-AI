# ====== VIDYAVERIFY AI — Environment Variables ======
# Copy to .env and fill in real values. NEVER commit .env.

# ---- Database ----
DATABASE_URL=postgresql://vidyaverify_user:vidyaverify_pass_2026@127.0.0.1:5432/vidyaverify

# ---- Backend ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_ENV=development
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ---- CORS ----
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- File Upload ----
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# ---- AI Copilot (Optional — leave blank for deterministic fallback) ----
# Supports OpenAI-compatible providers: OpenAI, Groq, Ollama, Anthropic (via proxy), etc.
# If LLM_PROVIDER or LLM_API_KEY is blank, the Copilot uses its reliable deterministic rule-based engine.
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_or_groq_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60

# ---- Demo Mode ----
DEMO_MODE=true
DEMO_LABEL=SYNTHETIC DEMONSTRATION DATA
